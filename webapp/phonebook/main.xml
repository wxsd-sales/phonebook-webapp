<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root directory file for the phone book web app, in the style of a Cisco IP
  Phone Services "CiscoIPPhoneDirectory" object.

  Two entry tags:
    - <DirectoryEntry>: a callable entry - <Name> plus <Telephone>. Rendered
      with "Call" and "Edit dial" buttons.
    - <MenuItem>: a folder - <Name> plus <URL> pointing at another directory
      XML file, fetched relative to this file when opened. Rendered with a
      single "Select" button.
-->
<CiscoIPPhoneDirectory>
  <Title>Company Directory</Title>
  <Prompt>Select Call or Edit dial for an entry</Prompt>
  <DirectoryEntry>
    <Name>Reception</Name>
    <Telephone>1000</Telephone>
  </DirectoryEntry>
  <DirectoryEntry>
    <Name>Help Desk</Name>
    <Telephone>2000</Telephone>
  </DirectoryEntry>
  <DirectoryEntry>
    <Name>Facilities</Name>
    <Telephone>2100</Telephone>
  </DirectoryEntry>
  <DirectoryEntry>
    <Name>Security</Name>
    <Telephone>2900</Telephone>
  </DirectoryEntry>
  <MenuItem>
    <Name>Sales Team</Name>
    <URL>sales.xml</URL>
  </MenuItem>
</CiscoIPPhoneDirectory>
